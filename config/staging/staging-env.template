# ==============================================================================
# ARTHAX STAGING ENVIRONMENT VARIABLE TEMPLATE (RAILWAY REFERENCE)
# ==============================================================================
# Note: In Railway, wire managed service references using ${{Service.VARIABLE}} syntax.
# NEVER commit real secret values to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API SERVICE (apps/api)
# ------------------------------------------------------------------------------

# Environment & Network
NODE_ENV=staging
API_PORT=3001
PORT=3001

# Managed Service References (Railway Private Network)
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# Security & Cryptographic Tokens (Generate high-entropy 64+ char random strings)
# Generate via: openssl rand -hex 32
JWT_SECRET=[GENERATE_SECURE_64_CHAR_HEX_TOKEN]
FINANCIAL_PEPPER=[GENERATE_SECURE_64_CHAR_HEX_TOKEN]

# Staging Pre-Deploy & Database Seeding Controls
RUN_MIGRATIONS=true
SEED_DATABASE=true

# Cross-Origin Resource Sharing (CORS) - Point to your staging web domain
CORS_ORIGIN=https://${{web.RAILWAY_PUBLIC_DOMAIN}}

# ------------------------------------------------------------------------------
# 2. WEB SERVICE (apps/web)
# ------------------------------------------------------------------------------

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# Backend Connectivity (Public or Private Railway Service Mesh URL)
NEXT_PUBLIC_API_URL=https://${{api.RAILWAY_PUBLIC_DOMAIN}}/api/v1
API_INTERNAL_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:3001/api/v1
