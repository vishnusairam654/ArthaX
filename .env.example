# ==============================================================================
# ARTHAX LOCAL DEVELOPMENT ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to ".env" and replace placeholder values for local usage.
# Never commit real secrets.
# ==============================================================================

# Core runtime
NODE_ENV=development
API_PORT=3001
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
BUILD_STANDALONE=false

# API/Web connectivity
API_INTERNAL_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
CORS_ORIGIN=http://localhost:3000

# Data stores
DATABASE_URL=******localhost:5432/arthax_dev?schema=public
REDIS_URL=redis://localhost:6379

# Security secrets (replace with high-entropy values)
JWT_SECRET=replace_with_minimum_64_char_secret
FINANCIAL_PEPPER=replace_with_minimum_64_char_secret

# Optional Supabase integration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional email integration
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_API_KEY=
EMAIL_FROM="ARTHAX Identity <onboarding@resend.dev>"

# Optional staging verification harness credentials
STAGING_GOV_ID=
STAGING_GOV_PASSWORD=
STAGING_FINANCIAL_PASSWORD=
