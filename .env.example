# ARTHAX — Environment Variable Template
# Copy to .env and fill in real values. NEVER commit .env.

# ---- Application ----
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# ---- Database (Docker Postgres, Phase 1+) ----
DATABASE_URL=postgresql://arthax:changeme@localhost:5432/arthax

# ---- Auth / Sessions (Phase 2) ----
JWT_SECRET=
SESSION_SECRET=

# ---- Email OTP (Phase 2; dev mode logs OTP to console) ----
EMAIL_OTP_DEV_MODE=true
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
