# ==============================================================================
# ARTHAX Sovereign Financial Ecosystem — Environment Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Secret values are never committed to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Secret: YES (production) | Default: local dev container
POSTGRES_USER=arthax
POSTGRES_PASSWORD=arthax_dev
POSTGRES_DB=arthax_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://arthax:arthax_dev@localhost:5432/arthax_dev?schema=public

# ------------------------------------------------------------------------------
# 2. Cache & Session Store (Redis 7)
# ------------------------------------------------------------------------------
# Secret: YES (if auth password set) | Default: localhost:6379
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. Security, Sessions & JWT
# ------------------------------------------------------------------------------
# Secret: YES (Must be a 256-bit cryptographically secure string in production)
JWT_SECRET=arthax_dev_jwt_secret_change_in_production_sovereign_key_9841
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# Session Cookie Name
SESSION_COOKIE_NAME=arthax_session

# ------------------------------------------------------------------------------
# 4. Cryptographic Hashing (Argon2id)
# ------------------------------------------------------------------------------
# Secret: NO (RFC 9106 recommended parameters for sensitive financial systems)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ------------------------------------------------------------------------------
# 5. Currency & Financial System Invariants
# ------------------------------------------------------------------------------
# Secret: NO
# Invariant: 1 ARTH = 100 minor units (integers only, no floats)
ARTH_MINOR_UNITS_SCALE=100
DEFAULT_CURRENCY=ARTH

# ------------------------------------------------------------------------------
# 6. OTP & Communications
# ------------------------------------------------------------------------------
# Secret: NO
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3

# Email Delivery Provider ('console' for local dev, 'resend' / 'sendgrid' for staging/prod)
EMAIL_PROVIDER=console
# Secret: YES (required when EMAIL_PROVIDER is not 'console')
EMAIL_API_KEY=
EMAIL_FROM=identity@arthax.sovereign

# ------------------------------------------------------------------------------
# 7. Application Ports & Networking
# ------------------------------------------------------------------------------
# Secret: NO
NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
WEB_PORT=3000
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 8. Document & Artifact Storage
# ------------------------------------------------------------------------------
# Secret: NO ('local' for dev, 's3' for cloud)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# Cloud Storage (when STORAGE_DRIVER=s3)
# S3_BUCKET=arthax-vault-documents
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ------------------------------------------------------------------------------
# 9. Rate Limiting & Abuse Prevention
# ------------------------------------------------------------------------------
# Secret: NO
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_OTP_MAX=3
RATE_LIMIT_OTP_WINDOW_SECONDS=600
RATE_LIMIT_TRANSFER_MAX=20
RATE_LIMIT_TRANSFER_WINDOW_SECONDS=3600
