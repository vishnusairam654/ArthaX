// ARTHAX Prisma schema.
// Phase 2: Identity, GOV ID & Unified Authentication.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  BANK_ADMIN
  CENTRAL_BANK_ADMIN
}

/// Invariant: 1 Email -> 1 GOV ID -> 1 ARTHAX User.
model User {
  id         String     @id @default(cuid())
  /// Lowercase, globally unique. Enforced by unique index below.
  email      String     @unique
  role       Role       @default(USER)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  govId      GovId?
  credential Credential?

  @@index([role])
}

/// Exactly one GOV ID per verified user. Human-readable public identifier.
model GovId {
  id        String   @id
  /// Format: AX<year>-<8 chars base32>. Unique across the system.
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuedAt  DateTime @default(now())
}

/// Dual-password architecture. The two hashes are never interchangeable:
/// - govPasswordHash authorizes login sessions only.
/// - financialPasswordHash authorizes transfers/trades/purchases only.
model Credential {
  userId                String   @id
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  govPasswordHash       String
  financialPasswordHash String?
  updatedAt             DateTime @updatedAt
}

/// One-time email verification codes. Hashed at rest, short-lived,
/// attempt-limited, single-consumption.
model EmailOtp {
  id          String    @id @default(cuid())
  email       String
  codeHash    String
  purpose     OtpPurpose
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
}

// ---------------------------------------------------------------------------
// Core Financial Ledger (Phase 3)
// One ledger. Every ARTH movement is a balanced journal entry.
// ---------------------------------------------------------------------------

enum LedgerAccountKind {
  /// A customer's money account (backed by a BankAccount in Phase 5).
  USER
  /// A commercial bank's own treasury (backs customer deposits).
  BANK_TREASURY
  /// CLS settlement account tracking a bank's net flow through the hub.
  CLS_SETTLEMENT
  /// Central Bank reserve / issuance account.
  CENTRAL_RESERVE
  /// Fee / tax income collected by the system.
  SYSTEM_INCOME
}

enum PostingSide {
  DEBIT
  CREDIT
}

/// Immutable. Balances are always derived from postings, never stored.
model LedgerAccount {
  id          String            @id @default(cuid())
  kind        LedgerAccountKind
  /// Owning user (USER accounts only).
  ownerUserId String?
  /// Owning commercial bank identifier (treasury/settlement/user accounts).
  bankId      String?
  currency    String            @default("ARTH")
  createdAt   DateTime          @default(now())

  postings LedgerPosting[]

  @@index([ownerUserId])
  @@index([bankId, kind])
}

/// A group of postings that must balance to zero. Immutable once written.
model JournalEntry {
  id            String   @id @default(cuid())
  transactionId String
  description   String
  createdAt     DateTime @default(now())

  transaction CoreTransaction @relation(fields: [transactionId], references: [id])
  postings    LedgerPosting[]

  @@index([transactionId])
}

model LedgerPosting {
  id            String      @id @default(cuid())
  journalEntryId String
  accountId     String
  side          PostingSide
  /// ARTH minor units. Always positive; the side carries direction.
  amountMinor   BigInt

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account      LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([journalEntryId])
}

enum TransactionState {
  PENDING
  VALIDATING
  AUTHORIZED
  PROCESSING
  SETTLING
  COMPLETED
  FAILED
  REVERSED
  CANCELLED
}

enum TransactionType {
  TRANSFER
  DEPOSIT
  WITHDRAWAL
  FD_OPEN
  FD_CLOSE
  FD_INTEREST
  TRADE_BUY
  TRADE_SELL
  SHOP_PURCHASE
  TAX
  FEE
  REVERSAL
}

enum TerminalReason {
  INSUFFICIENT_FUNDS
  VALIDATION_FAILED
  CANCELLED_BY_USER
  SYSTEM_ERROR
  NONE
}

/// The unit of financial intent. Walks the state machine exactly once.
model CoreTransaction {
  id             String           @id @default(cuid())
  /// Client-supplied unique key. Duplicate submissions return the original result.
  idempotencyKey String           @unique
  type           TransactionType
  state          TransactionState @default(PENDING)
  /// ARTH minor units.
  amountMinor    BigInt
  fromAccountId  String?
  toAccountId    String?
  feeMinor       BigInt           @default(0)
  terminalReason TerminalReason   @default(NONE)

  /// For REVERSAL transactions: the transaction being undone.
  reversalOfId String?  @unique
  reference    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  journalEntries JournalEntry[]
  events         TransactionEvent[]

  reversalOf CoreTransaction? @relation("Reversals", fields: [reversalOfId], references: [id])
  reversals  CoreTransaction[] @relation("Reversals")

  @@index([state])
  @@index([fromAccountId])
  @@index([toAccountId])
}

/// Append-only audit trail of every state transition.
model TransactionEvent {
  id            String           @id @default(cuid())
  transactionId String
  fromState     TransactionState?
  toState       TransactionState
  detail        String?
  createdAt     DateTime         @default(now())

  transaction CoreTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}
