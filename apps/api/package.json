{
  "name": "@arthax/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema=../../config/database/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=../../config/database/schema.prisma",
    "prisma:seed": "ts-node --transpile-only -P tsconfig.json ../../config/database/seeds/seed.ts",
    "test": "ts-node -r reflect-metadata"
  },
  "dependencies": {
    "@arthax/database": "workspace:*",
    "@arthax/types": "workspace:*",
    "@arthax/validation": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.4.1",
    "argon2": "^0.41.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.4.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^20.17.19",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
