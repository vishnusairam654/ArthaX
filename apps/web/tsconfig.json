{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../packages/config/nextjs.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./.next/tsconfig.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
